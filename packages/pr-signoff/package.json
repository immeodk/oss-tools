{
  "name": "@immeodk/pr-signoff",
  "version": "2.0.2",
  "description": "Pull Request Signoff Tool - Run CI checks and create status checks for pull requests",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immeodk/oss-tools.git",
    "directory": "packages/pr-signoff"
  },
  "homepage": "https://github.com/immeodk/oss-tools/tree/main/packages/pr-signoff#readme",
  "bugs": {
    "url": "https://github.com/immeodk/oss-tools/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "pr-signoff": "pr-signoff.js"
  },
  "scripts": {
    "start": "node ./pr-signoff.js",
    "dev": "tsx --watch src/index.ts",
    "build": "tsc && npm run copy-js",
    "copy-js": "node -e \"const fs=require('fs'); const path=require('path'); const glob=require('glob'); glob.sync('src/**/*.js').forEach(f => { const dest = f.replace('src/', 'dist/'); fs.mkdirSync(path.dirname(dest), {recursive: true}); fs.copyFileSync(f, dest); });\"",
    "type-check": "tsc --noEmit",
    "generate-schema": "tsx src/lib/schema/schema-generator.ts",
    "schema": "npm run generate-schema",
    "prebuild": "npm run type-check",
    "prepublishOnly": "npm run schema && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@octokit/openapi-types": "^28.0.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "glob": "^13.0.6",
    "ts-json-schema-generator": "^2.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@immeodk/git-utils": "^2.0.2",
    "@immeodk/schema-tools": "^2.0.2",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "keywords": [
    "azure-devops",
    "pull-request",
    "signoff",
    "ci",
    "status-check",
    "branch-policy"
  ],
  "author": "Immeo P/S",
  "license": "MIT",
  "files": [
    "dist/",
    "pr-signoff.js",
    "pr-signoff-schema.json",
    "pr-signoff.example.azuredevops.yaml",
    "pr-signoff.example.github.yaml",
    "README.md",
    "package.json",
    "templates/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
