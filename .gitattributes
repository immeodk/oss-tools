# Normalize to LF in the repo regardless of a contributor's local git config
# or OS — matches .editorconfig's end_of_line=lf and Prettier's endOfLine:
# "lf", so `format:check` can't fail in CI over line-ending drift alone.
* text=auto eol=lf

# Handle package-lock.json merge conflicts from platform-specific dependencies
**/package-lock.json linguist-generated=true merge=union
